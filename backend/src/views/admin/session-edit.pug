extends layout

block content
  .row
    .col-xs-12
      .box
        .box-header
          h3.box-title Edit Session
        
        .box-body
          form(method='POST', action=`/admin/sessions/${session.id}/edit`)
            .row
              .col-md-6
                .form-group
                  label Session ID:
                  p #{session.id}
                .form-group
                  label User:
                  p #{session.user.email} (#{session.user.firstName || ''} #{session.user.lastName || ''})
                .form-group
                  label Title
                  input.form-control(type='text', name='title', value=session.title, required)
                .form-group
                  .checkbox
                    label
                      input(type='checkbox', name='isActive', checked=session.isActive)
                      | Active
            
            .form-group
              button.btn.btn-primary(type='submit') Update Session
              a.btn.btn-default(href='/admin/sessions') Cancel