extends layout

block content
  .row
    .col-lg-3.col-xs-6
      .small-box.bg-aqua
        .inner
          h3 #{stats.userCount}
          p Users
        .icon
          i.ion.ion-person-add
        a.small-box-footer(href='/admin/users')
          | More info 
          i.fa.fa-arrow-circle-right
    
    .col-lg-3.col-xs-6
      .small-box.bg-green
        .inner
          h3 #{stats.chatSessionCount}
          p Chat Sessions
        .icon
          i.ion.ion-chatbubbles
        a.small-box-footer(href='/admin/sessions')
          | More info 
          i.fa.fa-arrow-circle-right
    
    .col-lg-3.col-xs-6
      .small-box.bg-yellow
        .inner
          h3 #{stats.messageCount}
          p Messages
        .icon
          i.ion.ion-chatbox
        a.small-box-footer(href='/admin/messages')
          | More info 
          i.fa.fa-arrow-circle-right
    
    .col-lg-3.col-xs-6
      .small-box.bg-red
        .inner
          h3 #{stats.marketingEmailCount}
          p Marketing Emails
        .icon
          i.ion.ion-email
        a.small-box-footer(href='/admin/marketing')
          | More info 
          i.fa.fa-arrow-circle-right
  
  .row
    .col-lg-3.col-xs-6
      .small-box.bg-purple
        .inner
          h3 #{stats.widgetSessionCount}
          p Widget Sessions
        .icon
          i.ion.ion-link
        a.small-box-footer(href='/admin/widget-sessions')
          | More info 
          i.fa.fa-arrow-circle-right
    
    .col-lg-3.col-xs-6
      .small-box.bg-maroon
        .inner
          h3 #{stats.widgetMessageCount}
          p Widget Messages
        .icon
          i.ion.ion-android-chat
        a.small-box-footer(href='/admin/widget-messages')
          | More info 
          i.fa.fa-arrow-circle-right
    
    .col-lg-3.col-xs-6
      .small-box.bg-navy
        .inner
          h3 #{stats.userCount > 0 ? Math.round(stats.messageCount / stats.userCount) : 0}
          p Avg Messages/User
        .icon
          i.ion.ion-stats-bars
        a.small-box-footer(href='#')
          | System Stats
          i.fa.fa-arrow-circle-right
    
    .col-lg-3.col-xs-6
      .small-box.bg-olive
        .inner
          h3 #{stats.chatSessionCount > 0 ? Math.round(stats.messageCount / stats.chatSessionCount) : 0}
          p Avg Messages/Session
        .icon
          i.ion.ion-pie-graph
        a.small-box-footer(href='#')
          | Analytics
          i.fa.fa-arrow-circle-right
  
  .row
    .col-md-12
      .box
        .box-header.with-border
          h3.box-title System Overview
        .box-body
          .row
            .col-md-6
              .info-box
                span.info-box-icon.bg-aqua
                  i.fa.fa-cog
                .info-box-content
                  span.info-box-text Server Status
                  span.info-box-number Online
                  .progress
                    .progress-bar(style='width: 100%')
                  span.info-box-more All systems operational
            
            .col-md-6
              .info-box
                span.info-box-icon.bg-green
                  i.fa.fa-database
                .info-box-content
                  span.info-box-text Database
                  span.info-box-number Connected
                  .progress
                    .progress-bar(style='width: 100%')
                  span.info-box-more PostgreSQL running normally