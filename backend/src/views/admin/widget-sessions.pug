extends layout

block content
  .row
    .col-xs-12
      .box
        .box-header
          h3.box-title Widget Sessions Management
          .box-tools
            a.btn.btn-success(href='/admin/widget-sessions/create')
              i.fa.fa-plus
              |  Add New Widget Session
        
        .box-body
          .table-responsive
            table#widget-sessions-table.table.table-bordered.table-striped
              thead
                tr
                  th ID
                  th Marketing Email
                  th Status
                  th Created
                  th Actions
              tbody
                each session in widgetSessions
                  tr
                    td #{session.id.substring(0, 8)}...
                    td #{session.marketingEmail ? session.marketingEmail.email : 'N/A'}
                    td
                      if session.isActive
                        span.label.label-success Active
                      else
                        span.label.label-danger Inactive
                    td #{new Date(session.createdAt).toLocaleDateString()}
                    td
                      a.btn.btn-sm.btn-info(href=`/admin/widget-sessions/${session.id}`)
                        i.fa.fa-eye
                        |  View
                      a.btn.btn-sm.btn-primary(href=`/admin/widget-sessions/${session.id}/edit`)
                        i.fa.fa-edit
                        |  Edit
                      a.btn.btn-sm.btn-danger(href=`/admin/widget-sessions/${session.id}/delete`, onclick='return confirm("Are you sure?")')
                        i.fa.fa-trash
                        |  Delete

block scripts
  script
    | $(document).ready(function() {
    |   $('#widget-sessions-table').DataTable({
    |     "responsive": true,
    |     "lengthChange": false,
    |     "autoWidth": false,
    |     "searching": true,
    |     "ordering": true,
    |     "info": true,
    |     "paging": true,
    |     "pageLength": 25,
    |     "language": {
    |       "search": "Search widget sessions:",
    |       "lengthMenu": "Show _MENU_ widget sessions per page",
    |       "info": "Showing _START_ to _END_ of _TOTAL_ widget sessions",
    |       "infoEmpty": "No widget sessions found",
    |       "infoFiltered": "(filtered from _MAX_ total widget sessions)"
    |     }
    |   });
    | });