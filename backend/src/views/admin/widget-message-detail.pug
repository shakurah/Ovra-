extends layout

block content
  .row
    .col-xs-12
      .box
        .box-header
          h3.box-title Widget Message Details
        
        .box-body
          .row
            .col-md-6
              .form-group
                label Message ID:
                p #{message.id}
              .form-group
                label Session:
                p #{message.sessionId}
              .form-group
                label Marketing Email:
                p #{message.session.marketingEmail ? message.session.marketingEmail.email : 'N/A'}
              .form-group
                label Role:
                p
                  if message.role === 'user'
                    span.label.label-primary User
                  else
                    span.label.label-info Assistant
              .form-group
                label Created:
                p #{new Date(message.createdAt).toLocaleString()}
              .form-group
                label Updated:
                p #{new Date(message.updatedAt).toLocaleString()}
            .col-md-6
              .form-group
                label Content:
                .well #{message.content}
        
        .box-footer
          a.btn.btn-primary(href=`/admin/widget/messages/${message.id}/edit`) Edit Message
          a.btn.btn-default(href='/admin/widget/messages') Back to Widget Messages