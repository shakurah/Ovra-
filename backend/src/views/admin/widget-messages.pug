extends layout

block content
  .row
    .col-xs-12
      .box
        .box-header
          h3.box-title Widget Messages Management
          .box-tools
            a.btn.btn-success(href='/admin/widget-messages/create')
              i.fa.fa-plus
              |  Add New Widget Message
        
        .box-body
          .table-responsive
            table#widget-messages-table.table.table-bordered.table-striped
              thead
                tr
                  th ID
                  th Session
                  th Role
                  th Content Preview
                  th Created
                  th Actions
              tbody
                each message in widgetMessages
                  tr
                    td #{message.id.substring(0, 8)}...
                    td #{message.sessionId.substring(0, 8)}...
                    td
                      if message.role === 'user'
                        span.label.label-primary User
                      else
                        span.label.label-info Assistant
                    td #{message.content.substring(0, 100)}#{message.content.length > 100 ? '...' : ''}
                    td #{new Date(message.createdAt).toLocaleDateString()}
                    td
                      a.btn.btn-sm.btn-info(href=`/admin/widget-messages/${message.id}`)
                        i.fa.fa-eye
                        |  View
                      a.btn.btn-sm.btn-primary(href=`/admin/widget-messages/${message.id}/edit`)
                        i.fa.fa-edit
                        |  Edit
                      a.btn.btn-sm.btn-danger(href=`/admin/widget-messages/${message.id}/delete`, onclick='return confirm("Are you sure?")')
                        i.fa.fa-trash
                        |  Delete

block scripts
  script
    | $(document).ready(function() {
    |   $('#widget-messages-table').DataTable({
    |     "responsive": true,
    |     "lengthChange": false,
    |     "autoWidth": false,
    |     "searching": true,
    |     "ordering": true,
    |     "info": true,
    |     "paging": true,
    |     "pageLength": 25,
    |     "language": {
    |       "search": "Search widget messages:",
    |       "lengthMenu": "Show _MENU_ widget messages per page",
    |       "info": "Showing _START_ to _END_ of _TOTAL_ widget messages",
    |       "infoEmpty": "No widget messages found",
    |       "infoFiltered": "(filtered from _MAX_ total widget messages)"
    |     }
    |   });
    | });