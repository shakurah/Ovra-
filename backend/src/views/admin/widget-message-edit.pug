extends layout

block content
  .row
    .col-xs-12
      .box
        .box-header
          h3.box-title Edit Widget Message
        
        .box-body
          form(method='POST', action=`/admin/widget/messages/${message.id}/edit`)
            .row
              .col-md-6
                .form-group
                  label Message ID:
                  p #{message.id}
                .form-group
                  label Session:
                  p #{message.sessionId}
                .form-group
                  label Marketing Email:
                  p #{message.session.marketingEmail ? message.session.marketingEmail.email : 'N/A'}
                .form-group
                  label Role:
                  p
                    if message.role === 'user'
                      span.label.label-primary User
                    else
                      span.label.label-info Assistant
              .col-md-6
                .form-group
                  label Content
                  textarea.form-control(name='content', rows='10', required)= message.content
            
            .form-group
              button.btn.btn-primary(type='submit') Update Message
              a.btn.btn-default(href='/admin/widget/messages') Cancel