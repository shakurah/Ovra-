extends layout

block content
  .row
    .col-xs-12
      .box
        .box-header
          h3.box-title Users Management
          .box-tools
            a.btn.btn-success(href='/admin/users/create')
              i.fa.fa-plus
              |  Add New User
        
        .box-body
          .table-responsive
            table#users-table.table.table-bordered.table-striped
              thead
                tr
                  th ID
                  th Email
                  th First Name
                  th Last Name
                  th Status
                  th Superuser
                  th Created
                  th Actions
              tbody
                each user in users
                  tr
                    td #{user.id.substring(0, 8)}...
                    td #{user.email}
                    td #{user.firstName || 'N/A'}
                    td #{user.lastName || 'N/A'}
                    td
                      if user.isActive
                        span.label.label-success Active
                      else
                        span.label.label-danger Inactive
                    td
                      if user.isSuperuser
                        span.label.label-warning Yes
                      else
                        span.label.label-default No
                    td #{new Date(user.createdAt).toLocaleDateString()}
                    td
                      a.btn.btn-sm.btn-info(href=`/admin/users/${user.id}`)
                        i.fa.fa-eye
                        |  View
                      a.btn.btn-sm.btn-primary(href=`/admin/users/${user.id}/edit`)
                        i.fa.fa-edit
                        |  Edit
                      a.btn.btn-sm.btn-danger(href=`/admin/users/${user.id}/delete`, onclick='return confirm("Are you sure?")')
                        i.fa.fa-trash
                        |  Delete

block scripts
  script
    | $(document).ready(function() {
    |   $('#users-table').DataTable({
