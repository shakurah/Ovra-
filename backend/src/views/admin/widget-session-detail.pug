extends layout

block content
  .row
    .col-xs-12
      .box
        .box-header
          h3.box-title Widget Session Details
        
        .box-body
          .row
            .col-md-6
              .form-group
                label Session ID:
                p #{session.id}
              .form-group
                label Marketing Email:
                p #{session.marketingEmail ? session.marketingEmail.email : 'N/A'}
              .form-group
                label Status:
                p
                  if session.isActive
                    span.label.label-success Active
                  else
                    span.label.label-danger Inactive
              .form-group
                label Created:
                p #{new Date(session.createdAt).toLocaleString()}
              .form-group
                label Updated:
                p #{new Date(session.updatedAt).toLocaleString()}
        
        .box-footer
          a.btn.btn-primary(href=`/admin/widget/sessions/${session.id}/edit`) Edit Session
          a.btn.btn-default(href='/admin/widget/sessions') Back to Widget Sessions
  
  if session.messages && session.messages.length > 0
    .row
      .col-xs-12
        .box
          .box-header
            h3.box-title Messages in this Session
          
          .box-body
            each message in session.messages
              .message
                .message-header
                  strong= message.role === 'user' ? 'User' : 'Assistant'
                  span.pull-right= new Date(message.createdAt).toLocaleString()
                p= message.content
                hr