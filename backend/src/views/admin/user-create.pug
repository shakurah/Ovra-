extends layout

block content
  .row
    .col-md-6
      .box.box-primary
        .box-header.with-border
          h3.box-title Create New User
        
        form(action='/admin/users/create', method='post')
          .box-body
            .form-group
              label(for='email') Email
              input#email.form-control(type='email', name='email', required)
            
            .form-group
              label(for='firstName') First Name
              input#firstName.form-control(type='text', name='firstName')
            
            .form-group
              label(for='lastName') Last Name
              input#lastName.form-control(type='text', name='lastName')
            
            .form-group
              label(for='password') Password
              input#password.form-control(type='password', name='password', required)
            
            .form-group
              .checkbox
                label
                  input(type='checkbox', name='isActive', checked)
                  |  Active
            
            .form-group
              .checkbox
                label
                  input(type='checkbox', name='isSuperuser')
                  |  Superuser
          
          .box-footer
            button.btn.btn-primary(type='submit') Create User
            a.btn.btn-default(href='/admin/users') Cancel