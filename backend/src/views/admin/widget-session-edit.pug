extends layout

block content
  .row
    .col-xs-12
      .box
        .box-header
          h3.box-title Edit Widget Session
        
        .box-body
          form(method='POST', action=`/admin/widget/sessions/${session.id}/edit`)
            .row
              .col-md-6
                .form-group
                  label Session ID:
                  p #{session.id}
                .form-group
                  label Marketing Email:
                  p #{session.marketingEmail ? session.marketingEmail.email : 'N/A'}
                .form-group
                  .checkbox
                    label
                      input(type='checkbox', name='isActive', checked=session.isActive)
                      | Active
            
            .form-group
              button.btn.btn-primary(type='submit') Update Session
              a.btn.btn-default(href='/admin/widget/sessions') Cancel