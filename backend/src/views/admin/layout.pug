doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title #{title} - OVRA AI Admin
    link(rel='stylesheet', href='/admin/assets/bower_components/bootstrap/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='/admin/assets/bower_components/font-awesome/css/font-awesome.min.css')
    link(rel='stylesheet', href='/admin/assets/bower_components/Ionicons/css/ionicons.min.css')
    link(rel='stylesheet', href='/admin/assets/dist/css/AdminLTE.min.css')
    link(rel='stylesheet', href='/admin/assets/dist/css/skins/_all-skins.min.css')
    link(rel='stylesheet', href='https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic')
    
  body.hold-transition.skin-blue.sidebar-mini
    .wrapper
      // Main Header
      header.main-header
        // Logo
        a.logo(href='/admin/dashboard')
          // mini logo for sidebar mini 50x50 pixels
          span.logo-mini
            b O
            | AI
          // logo for regular state and mobile devices
          span.logo-lg
            b OVRA
            |  AI Admin
        
        // Header Navbar
        nav.navbar.navbar-static-top(role='navigation')
          // Sidebar toggle button
          a.sidebar-toggle(href='#', data-toggle='push-menu', role='button')
            span.sr-only Toggle navigation
          
          // Navbar Right Menu
          .navbar-custom-menu
            ul.nav.navbar-nav
              li.dropdown.user.user-menu
                a.dropdown-toggle(href='#', data-toggle='dropdown')
                  img.user-image(src='/admin/assets/dist/img/user2-160x160.jpg', alt='User Image')
                  span.hidden-xs #{user ? user.email : 'Admin'}
                ul.dropdown-menu
                  li.user-header
                    img.img-circle(src='/admin/assets/dist/img/user2-160x160.jpg', alt='User Image')
                    p
                      | #{user ? user.email : 'Admin'}
                      small Member since #{user ? new Date(user.createdAt).toLocaleDateString() : 'Today'}
                  li.user-footer
                    .pull-right
                      a.btn.btn-default.btn-flat(href='/admin/logout') Sign out
      
      // Left side column. contains the sidebar
      aside.main-sidebar
        // sidebar
        section.sidebar
          // Sidebar user panel
          .user-panel
            .pull-left.image
              img.img-circle(src='/admin/assets/dist/img/user2-160x160.jpg', alt='User Image')
            .pull-left.info
              p #{user ? user.email : 'Admin'}
              a(href='#')
                i.fa.fa-circle.text-success
                |  Online
          
          // Sidebar Menu
          ul.sidebar-menu(data-widget='tree')
            li.header MAIN NAVIGATION
            li(class=title === 'Dashboard' ? 'active' : '')
              a(href='/admin/dashboard')
                i.fa.fa-dashboard
                span Dashboard
            li(class=title === 'Users Management' ? 'active' : '')
              a(href='/admin/users')
                i.fa.fa-users
                span Users
            li(class=title === 'Chat Sessions' ? 'active' : '')
              a(href='/admin/sessions')
                i.fa.fa-comments
                span Chat Sessions
            li(class=title === 'Chat Messages' ? 'active' : '')
              a(href='/admin/messages')
                i.fa.fa-comment
                span Chat Messages
            li(class=title === 'Marketing Emails' ? 'active' : '')
              a(href='/admin/marketing')
                i.fa.fa-envelope
                span Marketing Emails
            li(class=title === 'Widget Sessions' ? 'active' : '')
              a(href='/admin/widget-sessions')
                i.fa.fa-external-link
                span Widget Sessions
            li(class=title === 'Widget Messages' ? 'active' : '')
              a(href='/admin/widget-messages')
                i.fa.fa-external-link-square
                span Widget Messages
      
      // Content Wrapper
      .content-wrapper
        // Content Header (Page header)
        section.content-header
          h1 #{title}
          ol.breadcrumb
            li
              a(href='/admin/dashboard')
                i.fa.fa-dashboard
                |  Home
            li.active #{title}
        
        // Main content
        section.content
          block content
      
      // Footer
      footer.main-footer
        .pull-right.hidden-xs
          b Version
          |  1.0.0
        strong Copyright &copy; 2025 
          a(href='#') OVRA AI
          | .
        |  All rights reserved.
    
    // Scripts
    script(src='/admin/assets/bower_components/jquery/dist/jquery.min.js')
    script(src='/admin/assets/bower_components/bootstrap/dist/js/bootstrap.min.js')
    script(src='/admin/assets/dist/js/adminlte.min.js')
    
    block scripts