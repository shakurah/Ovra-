[Unit]
Description=Ovra AI Next.js Frontend Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=ovra_ai
Group=ovra_ai
WorkingDirectory=/home/ovra_ai/frontend
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3000
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=3
StandardOutput=append:/home/ovra_ai/logs/frontend.log
StandardError=append:/home/ovra_ai/logs/frontend.log

[Install]
WantedBy=multi-user.target
