[Unit]
Description=OVRA Frontend Next.js Service
After=network.target ovra-backend.service
Wants=network.target ovra-backend.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/ovra_ai/frontend
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.local/bin
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=NEXT_PUBLIC_API_URL=http://167.99.143.136:8000/api/v1
Environment=NEXT_PUBLIC_APP_URL=http://167.99.143.136:80
ExecStartPre=/usr/bin/pnpm install --frozen-lockfile
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=10
StandardOutput=append:/home/ovra_ai/logs/frontend.log
StandardError=append:/home/ovra_ai/logs/frontend.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ovra_ai/frontend
ReadWritePaths=/home/ovra_ai/logs

[Install]
WantedBy=multi-user.target
