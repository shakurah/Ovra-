[Unit]
Description=OVRA MCP BOE Server
After=network.target

[Service]
Type=simple
User=ali
Group=ali
WorkingDirectory=/home/ali/development/ovra_ai/mcp_boe
Environment=PATH=/home/ali/development/ovra_ai/backend/venv/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/ali/development/ovra_ai/mcp_boe
ExecStart=/home/ali/development/ovra_ai/backend/venv/bin/python server.py --host 0.0.0.0 --port 9000
Restart=always
RestartSec=5

# Logging
StandardOutput=append:/home/ali/development/ovra_ai/logs/mcp-boe.log
StandardError=append:/home/ali/development/ovra_ai/logs/mcp-boe.log
SyslogIdentifier=ovra-mcp-boe

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target