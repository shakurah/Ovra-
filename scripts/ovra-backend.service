[Unit]
Description=OVRA Backend Express.js Service
After=network.target postgresql.service
Wants=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ali
Group=ali
WorkingDirectory=/home/ali/development/ovra_ai/backend
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/ali/.local/bin
Environment=NODE_ENV=production
Environment=DATABASE_URL=postgresql://ovra_user:ovra_password@localhost:5432/ovra_ai
Environment=JWT_SECRET=your-secret-key-change-this-in-production
Environment=PORT=8000
Environment=HOST=0.0.0.0
ExecStartPre=/usr/bin/pnpm install --frozen-lockfile
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=10
StandardOutput=append:/home/ali/development/ovra_ai/logs/backend.log
StandardError=append:/home/ali/development/ovra_ai/logs/backend.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ali/development/ovra_ai/backend
ReadWritePaths=/home/ali/development/ovra_ai/logs

[Install]
WantedBy=multi-user.target