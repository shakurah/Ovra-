[Unit]
Description=Ovra AI FastAPI Backend Service
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
User=ali
Group=ali
WorkingDirectory=/home/ali/development/ovra_ai/backend
Environment=PATH=/home/ali/development/ovra_ai/backend/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/ali/development/ovra_ai/backend
ExecStartPre=/home/ali/development/ovra_ai/backend/venv/bin/alembic upgrade head
ExecStart=/home/ali/development/ovra_ai/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=3
StandardOutput=append:/home/ali/development/ovra_ai/logs/backend.log
StandardError=append:/home/ali/development/ovra_ai/logs/backend.log

[Install]
WantedBy=multi-user.target
