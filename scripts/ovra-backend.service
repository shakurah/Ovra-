[Unit]
Description=Ovra AI Django Backend Service
After=network.target postgresql.service redis-server.service
Wants=network.target

[Service]
Type=simple
User=ali
Group=ali
WorkingDirectory=/home/ali/development/ovra_ai/backend
Environment=PATH=/home/ali/development/ovra_ai/backend/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/ali/development/ovra_ai/backend
Environment=DJANGO_SETTINGS_MODULE=ovra_backend.settings
ExecStartPre=/home/ali/development/ovra_ai/backend/venv/bin/python manage.py migrate --check
ExecStart=/home/ali/development/ovra_ai/backend/venv/bin/daphne -b 0.0.0.0 -p 8000 ovra_backend.asgi:application
Restart=always
RestartSec=3
StandardOutput=append:/home/ali/development/ovra_ai/logs/backend.log
StandardError=append:/home/ali/development/ovra_ai/logs/backend.log

[Install]
WantedBy=multi-user.target
